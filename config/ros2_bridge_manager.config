<?xml version="1.0"?>
<!-- GUI config for opening Gazebo with the ROS 2 Bridge Manager loaded.
     Typical usage:
       gz sim <world.sdf> --gui-config <path-to-this-file>
-->
<window>
    <width>1400</width>
    <height>900</height>
</window>

<plugin filename="MinimalScene" name="3D View">
    <gz-gui>
        <title>3D View</title>
        <property type="bool" key="showTitleBar">false</property>
        <property type="string" key="state">docked</property>
    </gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.4 0.4 0.4</ambient_light>
    <background_color>0.8 0.8 0.8</background_color>
    <camera_pose>-5 0 3 0 0.35 0</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
    <gz-gui>
        <property key="state" type="string">floating</property>
        <property key="visible" type="bool">false</property>
    </gz-gui>
</plugin>

<plugin filename="EntityContextMenuPlugin" name="Entity context menu">
    <gz-gui>
        <property key="state" type="string">floating</property>
        <property key="visible" type="bool">false</property>
    </gz-gui>
</plugin>

<plugin filename="TransformControl" name="Transform Control">
    <gz-gui>
        <property key="state" type="string">floating</property>
        <property type="bool" key="showTitleBar">false</property>
    </gz-gui>
</plugin>

<plugin filename="Ros2BridgeManagerGui" name="ROS 2 Bridge Manager">
    <gz-gui>
        <title>ROS 2 Bridge Manager</title>
        <property type="string" key="state">docked</property>
        <property type="bool" key="showTitleBar">true</property>
    </gz-gui>
</plugin>

<dialog name="quick_start" show_again="false"/>
